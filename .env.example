# Draft Arena Environment Configuration

# Server Port
PORT=3001
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://draftarena_user:draftarena_pass@localhost:5432/draftarena_db

# JWT Secret for User Auth (when enabled)
JWT_SECRET=super_secret_jwt_key_change_in_production

# External Counter-Strike API Keys (Optional - HLTV / PandaScore / Steam API)
PANDASCORE_API_KEY=
STEAM_WEB_API_KEY=
